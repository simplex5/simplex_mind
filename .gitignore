Thumbs.db

# Project runtime dirs (created by init.py)
# config.json is deliberately NOT negated: it is local runtime state
# (onboarding_complete etc.) — committing it made fresh clones skip
# onboarding entirely (SIMP-D2-021).
database/*
!database/memory/
!database/ARCHITECTURE.md
database/memory/*
!database/memory/MEMORY.md
!database/memory/systems.md
logs/
.tmp/

# Note: database/memory/* above already keeps the subconscious index, personal
# keyword overlay, and autotune state machine-local — never shared.
